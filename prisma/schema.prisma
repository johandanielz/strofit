// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ENTRENADOR
  CLIENTE
}

// --- HU-22: sincronización de usuarios con Supabase Auth ---
model User {
  id             String    @id @default(uuid())
  supabaseUserId String    @unique
  email          String    @unique
  nombre         String
  telefono       String?
  rol            Rol
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  clienteProfile    Cliente?    @relation("ClienteUser")
  entrenadorProfile Entrenador? @relation("EntrenadorUser")

  @@index([rol])
  @@index([deletedAt])
}

model Entrenador {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation("EntrenadorUser", fields: [userId], references: [id], onDelete: Restrict)
  deletedAt DateTime?

  clientes Cliente[]

  @@index([deletedAt])
}

enum Sexo {
  MASCULINO
  FEMENINO
}

model Cliente {
  id              String     @id @default(uuid())
  userId          String     @unique
  user            User       @relation("ClienteUser", fields: [userId], references: [id], onDelete: Restrict)
  entrenadorId    String
  entrenador      Entrenador @relation(fields: [entrenadorId], references: [id], onDelete: Restrict)
  sexo            Sexo
  fechaNacimiento DateTime
  factorActividad Float
  deletedAt       DateTime?

  citasAgenda  CitaAgenda[]
  valoraciones Valoracion[]
  macrociclos  Macrociclo[]

  @@index([entrenadorId])
  @@index([deletedAt])
}

model CitaAgenda {
  id                  String    @id @default(uuid())
  clienteId           String
  cliente             Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fechaInicio         DateTime
  fechaFin            DateTime
  observaciones       String?
  realizada           Boolean   @default(false)
  cancelada           Boolean   @default(false)
  reagendada          Boolean   @default(false)
  fechaInicioOriginal DateTime?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  valoracion Valoracion?

  @@index([clienteId, fechaInicio])
}

model Valoracion {
  id           String      @id @default(uuid())
  clienteId    String
  cliente      Cliente     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  citaAgendaId String?     @unique
  citaAgenda   CitaAgenda? @relation(fields: [citaAgendaId], references: [id], onDelete: Restrict)
  fecha        DateTime    @default(now())
  peso         Float
  altura       Float // en metros, snapshot — se sugiere el valor de la valoración anterior, editable

  // Pliegues (mm) - los 7 marcados entran en la fórmula Jackson & Pollock
  pliegueEscapular     Float // = Subescapular
  pliegueTricipital    Float // = Tríceps
  pliegueBicipital     Float // no entra en la fórmula
  pliegueEctoral       Float // = Pectoral
  pliegueAxial         Float // = Axilar medio
  pliegueSuprailico    Float // = Suprailiaco
  pliegueAbdominal     Float // = Abdominal
  pliegueEnPierna      Float // = Muslo
  pliegueEnPantorrilla Float // no entra en la fórmula

  // Medidas (cm)
  cuello               Float
  brazoIzquierdo       Float
  brazoDerecho         Float
  hombros              Float
  pecho                Float
  antebrazoIzquierdo   Float
  antebrazoDerecho     Float
  cintura              Float
  abdomen              Float
  absBajo              Float
  cadera               Float
  piernaAltaIzquierda  Float
  piernaAltaDerecha    Float
  piernaIzquierda      Float
  piernaDerecha        Float
  piernaBajaIzquierda  Float
  piernaBajaDerecha    Float
  pantorrillaIzquierda Float
  pantorrillaDerecha   Float

  // Punto crítico (opcional)
  puntoCriticoNombre String?
  puntoCriticoMedida Float?

  // Calculados y guardados (snapshot del momento)
  suma7Pliegues    Float
  densidadCorporal Float
  porcentajeGrasa  Float
  masaGrasa        Float
  masaLibreGrasa   Float
  imc              Float
  caloriasBasales  Float
  factorActividad  Float // snapshot del Cliente.factorActividad en este momento
  caloriasTeoricas Float // basales x factorActividad

  deletedAt DateTime?

  fotos FotoValoracion[]

  @@index([clienteId, fecha])
  @@index([deletedAt])
}

enum AnguloFoto {
  FRONTAL
  ESPALDA
  PERFIL_DERECHO
  PERFIL_IZQUIERDO
}

model FotoValoracion {
  id           String     @id @default(uuid())
  valoracionId String
  valoracion   Valoracion @relation(fields: [valoracionId], references: [id], onDelete: Restrict)
  angulo       AnguloFoto
  storagePath  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([valoracionId, angulo])
}

model CategoriaEjercicio {
  id        String    @id @default(uuid())
  nombre    String    @unique
  deletedAt DateTime?

  ejercicios EjercicioBiblioteca[]

  @@index([nombre])
  @@index([deletedAt])
}

model EjercicioBiblioteca {
  id            String             @id @default(uuid())
  categoriaId   String
  categoria     CategoriaEjercicio @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  nombre        String
  notasTecnicas String?
  videoUrl      String?
  deletedAt     DateTime?

  usos Ejercicio[]

  @@index([categoriaId])
  @@index([deletedAt])
}

model Macrociclo {
  id          String    @id @default(uuid())
  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  fechaInicio DateTime  @default(now())
  deletedAt   DateTime?

  microciclos Microciclo[]

  @@index([clienteId])
  @@index([deletedAt])
}

model Microciclo {
  id           String     @id @default(uuid())
  macrocicloId String
  macrociclo   Macrociclo @relation(fields: [macrocicloId], references: [id], onDelete: Restrict)
  numero       Int
  fechaInicio  DateTime
  fechaFin     DateTime
  deletedAt    DateTime?

  sesiones SesionEntrenamiento[]

  @@unique([macrocicloId, numero])
  @@index([deletedAt])
}

model SesionEntrenamiento {
  id           String     @id @default(uuid())
  microcicloId String
  microciclo   Microciclo @relation(fields: [microcicloId], references: [id], onDelete: Restrict)
  numero       Int
  fecha        DateTime
  deletedAt    DateTime?

  ejercicios Ejercicio[]

  @@unique([microcicloId, numero])
  @@index([deletedAt])
}

model Ejercicio {
  id                    String              @id @default(uuid())
  sesionId              String
  sesion                SesionEntrenamiento @relation(fields: [sesionId], references: [id], onDelete: Restrict)
  bibliotecaId          String
  biblioteca            EjercicioBiblioteca @relation(fields: [bibliotecaId], references: [id], onDelete: Restrict)
  orden                 Int
  numeroSeries          Int
  repeticionesSugeridas String
  descansoSegundos      Int
  rir                   String?
  deletedAt             DateTime?

  registros RegistroSerie[]

  @@index([sesionId, orden])
  @@index([deletedAt])
}

model RegistroSerie {
  id            String    @id @default(uuid())
  ejercicioId   String
  ejercicio     Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)
  numeroSerie   Int
  carga         Float
  reps          Int
  rir           String?
  observaciones String?
  deletedAt     DateTime?

  @@unique([ejercicioId, numeroSerie])
  @@index([deletedAt])
}
